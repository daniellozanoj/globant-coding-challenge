# Copy to .env and adjust. Every variable has a sensible local default.

# --- Database ---
# Either a full SQLAlchemy URL (takes precedence)...
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/globant
# ...or its components (this is how AWS injects them).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=globant
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=5

# --- Ingestion ---
LOCAL_DATA_DIR=data
MAX_UPLOAD_MB=50

# --- AWS (only needed for the cloud features) ---
# DB_IAM_AUTH=true
# AWS_REGION=us-east-1
# RAW_BUCKET=my-raw-bucket
# UPLOAD_URL_EXPIRATION_SECONDS=900

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
